# Скопируйте в .env (локально) или задайте в EAS Hosting: npx eas-cli@latest env:set (см. README)
# Эти значения нужны только серверу — в приложение они не попадают.

# Telegram: токен бота @Balala_app_bot от @BotFather (вид 123456789:AAH…) и id чатов, куда слать заказы.
# Несколько получателей — через запятую: группа и рабочий аккаунт, например -1001234567890,123456789
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ЮKassa: Личный кабинет → Интеграция → Ключи API
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# true — передавать чек по 54-ФЗ (если подключены «Чеки от ЮKassa» или онлайн-касса)
YOOKASSA_SEND_RECEIPT=false
# Ставка НДС для чека: 1 — без НДС, 2 — 0%, 3 — 10%, 4 — 20% (уточните у бухгалтера)
YOOKASSA_VAT_CODE=1

# Адрес сервера для приложения (после публикации на EAS Hosting)
# EXPO_PUBLIC_API_URL=https://balala-flowers.expo.app
